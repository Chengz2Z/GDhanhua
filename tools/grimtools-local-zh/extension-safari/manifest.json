{
  "manifest_version": 3,
  "name": "GrimTools 本地汉化优先",
  "version": "0.2.0",
  "description": "让 GrimTools 构筑模拟器优先使用本地 Text_ZH 汉化，缺失 KEY 自动回退网页中文。",
  "permissions": [
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.grimtools.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "grimtools_zh_redirects",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "generated/db-zh.js",
        "generated/editor-zh.js"
      ],
      "matches": [
        "https://www.grimtools.com/*"
      ]
    }
  ]
}
