{
  "manifest_version": 3,
  "name": "GrimTools 本地化",
  "version": "0.3.0",
  "description": "为 GrimTools 增加可切换的本地简体中文，本地缺失 KEY 自动回退网页中文。",
  "minimum_chrome_version": "88",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://www.grimtools.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "grimtools_zh_redirects",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.grimtools.com/calc*"
      ],
      "js": [
        "generated/language-mode-selector.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "generated/db-zh.js",
        "generated/editor-zh.js"
      ],
      "matches": [
        "https://www.grimtools.com/*"
      ]
    }
  ]
}
